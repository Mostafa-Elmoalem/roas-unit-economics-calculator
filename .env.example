# =================================================================
# TrueROAS - Environment Variables Template
# =================================================================

# Server Port (Only used if exposing port directly to host)
PORT=8080

# Docker Reverse Proxy Network on the server
# (e.g. airbot-stack_app-network, nginx-proxy-manager_default, traefik-net)
PROXY_NETWORK=airbot-stack_app-network

# =================================================================
# Phase 2 — api service + PostgreSQL (docker-compose.dev.yml / docker-compose.yml)
# =================================================================

# Host port for the dev api container (localhost-only; Vite proxies /api here)
API_PORT=3000

# Postgres credentials/database (shared by the dev and prod compose stacks,
# consumed by both the postgres service and the api's DATABASE_URL)
POSTGRES_USER=trueroas
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trueroas

# Host port for the dev postgres container (localhost-only)
POSTGRES_PORT=5432

# Only needed when running the api directly on the host (npm --prefix api run dev)
# Inside compose the api builds DATABASE_URL from the POSTGRES_* values above.
DATABASE_URL=postgres://trueroas:change-me@localhost:5432/trueroas

# Ingest rate limit per deviceId per minute (api service)
RATE_LIMIT_PER_MINUTE=60

# Vite dev-server proxy target for /api (used by `npm run dev` on the host)
VITE_DEV_API_URL=http://localhost:3000

# Telemetry kill-switch: set to true at build time to disable all ingest attempts
VITE_TELEMETRY_DISABLED=false
