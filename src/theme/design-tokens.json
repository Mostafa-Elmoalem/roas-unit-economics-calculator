{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "TrueROAS Design Tokens",
  "version": "1.0.0",
  "description": "Three-layer design token architecture: Primitive -> Semantic -> Component",
  "layers": {
    "primitives": {
      "color": {
        "zinc": {
          "50": "#fafafa",
          "100": "#f4f4f5",
          "200": "#e4e4e7",
          "300": "#d4d4d8",
          "400": "#a1a1aa",
          "500": "#71717a",
          "600": "#52525b",
          "700": "#3f3f46",
          "800": "#27272a",
          "900": "#18181b",
          "950": "#09090b"
        },
        "emerald": {
          "50": "#ecfdf5",
          "100": "#d1fae5",
          "200": "#a7f3d0",
          "300": "#6ee7b7",
          "400": "#34d399",
          "500": "#10b981",
          "600": "#059669",
          "700": "#047857",
          "900": "#064e3b",
          "950": "#022c22"
        },
        "rose": {
          "50": "#fff1f2",
          "100": "#ffe4e6",
          "200": "#fecdd3",
          "300": "#fda4af",
          "400": "#fb7185",
          "500": "#f43f5e",
          "600": "#e11d48",
          "700": "#be123c",
          "900": "#881337",
          "950": "#4c0519"
        },
        "amber": {
          "500": "#f59e0b",
          "600": "#d97706"
        },
        "indigo": {
          "500": "#6366f1",
          "600": "#4f46e5"
        }
      },
      "spacing": {
        "0": "0px",
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
        "5": "20px",
        "6": "24px",
        "8": "32px"
      },
      "radius": {
        "sm": "6px",
        "md": "8px",
        "lg": "12px",
        "xl": "16px",
        "full": "9999px"
      }
    },
    "semantic": {
      "light": {
        "bg": {
          "app": "{primitives.color.zinc.50}",
          "surface": "#ffffff",
          "surfaceSubtle": "{primitives.color.zinc.100}",
          "input": "{primitives.color.zinc.50}",
          "hover": "{primitives.color.zinc.100}"
        },
        "border": {
          "default": "{primitives.color.zinc.200}",
          "subtle": "{primitives.color.zinc.100}",
          "focus": "{primitives.color.emerald.500}"
        },
        "text": {
          "primary": "{primitives.color.zinc.900}",
          "secondary": "{primitives.color.zinc.600}",
          "muted": "{primitives.color.zinc.400}"
        }
      },
      "dark": {
        "bg": {
          "app": "{primitives.color.zinc.950}",
          "surface": "{primitives.color.zinc.900}",
          "surfaceSubtle": "#121214",
          "input": "{primitives.color.zinc.950}",
          "hover": "#202024"
        },
        "border": {
          "default": "{primitives.color.zinc.800}",
          "subtle": "#1f1f23",
          "focus": "{primitives.color.emerald.500}"
        },
        "text": {
          "primary": "{primitives.color.zinc.100}",
          "secondary": "{primitives.color.zinc.400}",
          "muted": "{primitives.color.zinc.500}"
        }
      },
      "status": {
        "profit": "{primitives.color.emerald.500}",
        "loss": "{primitives.color.rose.500}",
        "warning": "{primitives.color.amber.500}",
        "accent": "{primitives.color.indigo.500}"
      }
    },
    "components": {
      "button": {
        "primary": {
          "bg": "{semantic.status.profit}",
          "text": "{primitives.color.zinc.950}",
          "hover": "{primitives.color.emerald.400}"
        },
        "destructive": {
          "bg": "{semantic.status.loss}",
          "text": "#ffffff",
          "hover": "{primitives.color.rose.600}"
        }
      },
      "card": {
        "bg": "var(--color-bg-surface)",
        "border": "var(--color-border-default)",
        "radius": "{primitives.radius.xl}"
      },
      "badge": {
        "profit": {
          "bg": "rgba(16, 185, 129, 0.1)",
          "border": "rgba(16, 185, 129, 0.3)",
          "text": "{semantic.status.profit}"
        },
        "loss": {
          "bg": "rgba(244, 63, 94, 0.1)",
          "border": "rgba(244, 63, 94, 0.3)",
          "text": "{semantic.status.loss}"
        }
      }
    }
  }
}
