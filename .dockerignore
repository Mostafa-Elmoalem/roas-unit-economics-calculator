# Build context exclusions
node_modules
dist
dist-ssr

# Version control
.git
.gitignore

# CI/CD & DevOps (not needed inside the container)
.github
.dockerignore
Dockerfile
docker-compose.yml
docker-compose*.yml

# Agent / IDE / Editor configs
.agent
.agents
.claude
.codex
.impeccable
_bmad
_bmad-output
.vscode
.idea
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Env files (secrets must never be baked into images)
.env
.env.*
*.local

# Documentation (not needed at runtime)
*.md
DESIGN.md
EXPERIENCE.md
README.md
LICENSE

# Lint / config not needed for build
.oxlintrc.json
